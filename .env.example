# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Personal ngrok dev domain, for example https://your-assigned-name.ngrok-free.dev
WEBHOOK_BASE_URL=https://your-assigned-name.ngrok-free.dev

# PostgreSQL (must match the PostgreSQL configuration)
ANALYTICS_POSTGRES_PORT=5434
ConnectionStrings__Analytics="Host=localhost;Port=5434;Database=analytics;Username=teammemory;Password=teammemory"
ConnectionStrings__Postgres="Host=localhost;Port=5434;Database=group_dashboard;Username=teammemory;Password=teammemory"

# Dashboard / Telegram Mini App
# Local browser login without Telegram; real Mini App uses signed initData.
MINIAPP_DEVELOPMENT_MANAGER_ID=123456789
# Optional Telegram webhook secret (A-Z a-z 0-9 _ -).
TELEGRAM_WEBHOOK_SECRET=

# Demo group seeded by Dashboard in Development. Use the same ChatId in test messages.
DEMO_GROUP_CHAT_ID=-1001234567890
DEMO_GROUP_TITLE=Demo Team

# RabbitMQ (must match the broker configuration)
RabbitMq__Host=localhost
RabbitMq__VirtualHost=/
RabbitMq__Username=teammemory
RabbitMq__Password=teammemory

# OpenAI-compatible LLM API (DeepSeek)
LlmApi__Endpoint=https://api.deepseek.com/chat/completions
LlmApi__Model=deepseek-flash
LlmApi__ApiKey=
LlmApi__MaxTokens=1500
LlmApi__TimeoutSeconds=300
LlmApi__UseJsonMode=true

# Analytics processing
Analytics__IdleSeconds=60
Analytics__MaxWaitSeconds=300
Analytics__MaxMessages=100
Analytics__PollSeconds=5
Analytics__MaxAttempts=5
Analytics__MinimumConfidence=0.70
Analytics__RiskMultiplier=1.5
