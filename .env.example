# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional ngrok URL for Telegram webhook registration. Leave empty for local HTTP tests.
WEBHOOK_BASE_URL=

# Local GGUF model used by AnalyticsService
Llama__ModelPath=E:/FIIT/models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf

# Chat/team routing for Analytics in Docker (100 is the local test chat).
ANALYTICS_CHAT_ID=100
ANALYTICS_TEAM_ID=team-demo
MINIAPP_DEVELOPMENT_MANAGER_ID=123456789

# Host PostgreSQL port; containers always use postgres:5432.
POSTGRES_PORT=5434
# Limit simultaneous Compose operations on machines with little free memory.
COMPOSE_PARALLEL_LIMIT=1
COMPOSE_BAKE=false
