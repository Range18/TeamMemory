{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	@telegram {
		method POST
		path /api/telegram/webhook
	}
	handle @telegram {
		reverse_proxy ingestion:8080
	}
	handle /health* {
		reverse_proxy dashboard:8080
	}
	handle /api/* {
		reverse_proxy dashboard:8080
	}
	handle /hubs/* {
		reverse_proxy dashboard:8080
	}
	handle {
		reverse_proxy frontend:80
	}
}
