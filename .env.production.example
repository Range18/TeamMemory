# Copy to .env.production; chmod 600. Never commit the filled file.
# Use a DNS hostname only, without scheme, path or port.
APP_DOMAIN=bot.example.com
ACME_EMAIL=ops@example.com
# Unique tag for each release. Keep previous images for rollback.
APP_IMAGE_TAG=release-001

POSTGRES_DB=analytics
POSTGRES_USER=teammemory
# Generate independent passwords with: openssl rand -hex 32
# Use hex passwords here: PostgreSQL password is embedded in a connection string.
POSTGRES_PASSWORD=
RABBITMQ_USER=teammemory
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

TELEGRAM_BOT_TOKEN=
# Generate with: openssl rand -hex 32. Allowed characters: A-Z a-z 0-9 _ -.
TELEGRAM_WEBHOOK_SECRET=

LlmApi__Endpoint=https://api.deepseek.com/chat/completions
LlmApi__Model=deepseek-flash
LlmApi__ApiKey=
LlmApi__MaxTokens=1500
LlmApi__TimeoutSeconds=300
LlmApi__UseJsonMode=true

Analytics__IdleSeconds=60
Analytics__MaxWaitSeconds=300
Analytics__MaxMessages=100
Analytics__PollSeconds=5
Analytics__MaxAttempts=5
Analytics__MinimumConfidence=0.70
Analytics__RiskMultiplier=1.5
